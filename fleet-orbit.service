[Unit]
Description=Orbit osquery
After=network.service syslog.service
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/etc/default/fleet-orbit
ExecStart=/opt/fleet-orbit/bin/orbit/orbit
Restart=always
RestartSec=15s
KillMode=control-group
KillSignal=SIGTERM
CPUQuota=20%

[Install]
WantedBy=multi-user.target
